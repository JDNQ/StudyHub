# Supabase (create a project at https://supabase.com, then paste keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# LLM via FreeLLMAPI (OpenAI-compatible). Install: https://github.com/tashfeenahmed/freellmapi
# Unified key from FreeLLMAPI dashboard (Keys page), not a raw OpenAI key.
OPENAI_BASE_URL=http://localhost:3001/v1
OPENAI_API_KEY=freellmapi-...
OPENAI_MODEL=auto

# App limits
QUIZ_DAILY_LIMIT=10
MAX_PDF_BYTES=10485760
